<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.laboratorioorm.controller.EquipoController"
      prefWidth="950.0"
      prefHeight="620.0"
      spacing="12.0">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <children>
        <Label text="Control de equipos de laboratorio"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="75.0"/>
                <ColumnConstraints minWidth="180.0" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="75.0"/>
                <ColumnConstraints minWidth="180.0" hgrow="ALWAYS"/>
            </columnConstraints>

            <children>
                <Label text="Código:"/>
                <TextField fx:id="txtCodigo"
                           promptText="Código del equipo"
                           GridPane.columnIndex="1"/>

                <Label text="Nombre:"
                       GridPane.columnIndex="2"/>
                <TextField fx:id="txtNombre"
                           promptText="Nombre del equipo"
                           GridPane.columnIndex="3"/>

                <Label text="Marca:"
                       GridPane.rowIndex="1"/>
                <TextField fx:id="txtMarca"
                           promptText="Marca del equipo"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Cantidad:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>
                <TextField fx:id="txtCantidad"
                           promptText="Cantidad"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="1"/>

                <Label text="Tipo:"
                       GridPane.rowIndex="2"/>
                <ComboBox fx:id="cmbTipoEquipo"
                          promptText="Seleccione un tipo"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Estado:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2"/>
                <ComboBox fx:id="cmbEstado"
                          promptText="Seleccione un estado"
                          maxWidth="Infinity"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="2"/>
            </children>
        </GridPane>

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button text="Guardar" disable="true"/>
                <Button text="Actualizar" disable="true"/>
                <Button text="Eliminar" disable="true"/>
                <Button text="Limpiar"
                        onAction="#limpiarCampos"/>
                <Button text="Recargar"
                        onAction="#cargarEquipos"/>
            </children>
        </HBox>

        <Separator/>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Buscar por nombre:"/>
                <TextField fx:id="txtBuscarNombre"
                           promptText="Nombre del equipo"
                           disable="true"
                           HBox.hgrow="ALWAYS"/>

                <Label text="Filtrar por tipo:"/>
                <ComboBox fx:id="cmbFiltroTipo"
                          promptText="Todos los tipos"
                          prefWidth="170.0"
                          disable="true"/>

                <Button text="Aplicar filtros" disable="true"/>
            </children>
        </HBox>

        <TableView fx:id="tblEquipos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo"
                             text="Código"
                             prefWidth="110.0"/>
                <TableColumn fx:id="colNombre"
                             text="Nombre"
                             prefWidth="210.0"/>
                <TableColumn fx:id="colMarca"
                             text="Marca"
                             prefWidth="120.0"/>
                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="160.0"/>
                <TableColumn fx:id="colCantidad"
                             text="Cantidad"
                             prefWidth="90.0"/>
                <TableColumn fx:id="colTipo"
                             text="Tipo de equipo"
                             prefWidth="170.0"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label text="No hay equipos para mostrar."/>
            </placeholder>
        </TableView>
    </children>
</VBox>
